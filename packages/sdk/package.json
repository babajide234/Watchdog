{
  "name": "@watchdog/sdk",
  "version": "0.1.0",
  "description": "Lightweight React error monitoring SDK",
  "author": "React Watchdog Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/watchdog/watchdog.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/watchdog/watchdog/issues"
  },
  "homepage": "https://github.com/watchdog/watchdog#readme",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "tsup src/index.ts --watch --format cjs,esm,iife --global-name Watchdog --dts",
    "build": "tsup src/index.ts --format cjs,esm,iife --global-name Watchdog --dts",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^1.6.0",
    "jsdom": "^24.0.0",
    "tsup": "^8.0.2",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "react",
    "monitoring",
    "error-tracking",
    "sentry"
  ]
}
